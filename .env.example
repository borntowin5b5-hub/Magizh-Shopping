# ================================================================
# MAGIZH SHOPPING + B5 COIN COMMERCE ECOSYSTEM
# Environment Configuration Template
# ================================================================

# Server Port (Render sets this dynamically via $PORT)
PORT=3001
NODE_ENV=production

# Database Configuration
# - If unset or left blank: Uses high-performance SQLite database persisted to server/data/magizh.sqlite
# - For Render PostgreSQL: provide the external connection string (e.g., postgresql://user:pass@host/dbname)
DATABASE_URL=

# Real Email Delivery Service (SMTP)
# Configure with SendGrid, Mailgun, Amazon SES, or Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@magizh.in
SMTP_PASS=your_app_password_here
EMAIL_FROM=Magizh Shopping <support@magizh.in>

# Note on OTP Development Mock Mode:
# If SMTP credentials are not configured or left blank, the platform automatically
# activates the clearly labeled "[DEMO MODE] Time-Limited Password Reset OTP" banner
# on the UI, displaying the genuine 6-digit OTP for seamless developer testing.
# No mock email is ever represented as a real email delivery.

# CORS Allowed Origin (Default is * for flexible cross-origin testing)
CORS_ORIGIN=*
